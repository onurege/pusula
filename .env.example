# Univera MSSQL — READ ONLY user (db_datareader)
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERT=true

# Gemini — used for embeddings (and later, enrichment description drafts)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_GENERATION_MODEL=gemini-2.5-flash-lite

# Schema introspection toggles
INTROSPECT_SAMPLE_ROWS=5
INTROSPECT_INCLUDE_SYSTEM_TABLES=false
