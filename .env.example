# Univera MSSQL — READ ONLY user (db_datareader)
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERT=true

# Gemini — embeddings + LLM-drafted descriptions + report generation
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_GENERATION_MODEL=gemini-2.5-flash-lite

# HTTP API
API_PORT=8080

# Dashboard (Next.js) — points at the HTTP API
# Set in apps/dashboard/.env.local for client-side use:
#   NEXT_PUBLIC_ENROUTE_API_URL=http://localhost:8080

# Schema introspection toggles
INTROSPECT_SAMPLE_ROWS=5
INTROSPECT_INCLUDE_SYSTEM_TABLES=false

# Auth — üretim ZORUNLU değişkenler (packages/core/src/auth.ts)
# JWT_SECRET: HS256 oturum imzalama anahtarı. En az 32 baytlık rastgele bir
#   değer kullanın (örn. `openssl rand -base64 32`). NODE_ENV=production iken
#   boşsa uygulama boot'ta throw ile AÇILMAZ (fail-fast, sabit fallback yok).
JWT_SECRET=PLACEHOLDER_min_32_byte_random_secret

# UNIVERA_PW_KEY: Univera şifrelerini şifreleyen AES-128/192/256-ECB anahtarı
#   (hex, base64 veya ham 16/24/32 karakter utf8 olabilir). NODE_ENV=production
#   iken yoksa veya self-test tutmuyorsa boot'ta throw (şifre doğrulaması
#   atlanamaz). Yalnız dev ortamında (NODE_ENV != production) anahtar yoksa
#   DEMO MODU'na düşülür (her şifre kabul edilir) — üretimde bilinçli olarak
#   izin vermek için ALLOW_DEMO_AUTH=1 kullanın.
UNIVERA_PW_KEY=PLACEHOLDER_univera_aes_key

# NODE_ENV: "production" olduğunda yukarıdaki auth guard'ları devreye girer.
NODE_ENV=development

# TENANT: aktif kiracı şeması / veri kümesi seçici (bkz. packages/core/src/tenant).
TENANT=

# CONFIG_ENC_KEY: Insider konfigüratörünün runtime override store'undaki
#   (tenant/mapping-store.ts) DB parolası gibi alanları şifreleyen AES-256-GCM
#   anahtarı. Tam 32 bayt olmalı — 64 karakter hex ya da 32 bayta çözülen
#   base64 (örn. `openssl rand -base64 32`). Eksik/hatalı ise şifreli alan
#   okuma/yazma FAIL-CLOSED throw eder (auth.ts'teki UNIVERA_PW_KEY'in aksine
#   sessiz demo-moda düşmez — bu DB kimlik bilgisi, sessiz düşüş kabul edilemez).
CONFIG_ENC_KEY=

# DEMO_DATE: demo/rapor senaryolarında "bugün" olarak kabul edilen sabit tarih
#   (YYYY-MM-DD). Boşsa gerçek sistem tarihi kullanılır.
DEMO_DATE=

# SETUP_TOKEN: güvenli setup modunun (Faz A Dalga 2, packages/core/src/tenant/
#   setup-mode.ts) tek kapısı — boş sunucu tavuk-yumurtası (yeni TENANT=<id>
#   ile açılışta ne REGISTRY'de ne tenant-definition store'da bir tanım varsa
#   normal admin girişi mümkün değildir). En az 32 bayt rastgele değer
#   (`openssl rand -base64 32`); KISA ise setup modu FAIL-CLOSED devre dışı
#   kalır. Yalnız `/api/setup/db-connection{,/test}` ve `/api/setup/tenant`
#   uçlarını `x-setup-token` header'ıyla açar — aktif tenant "tamamlanınca"
#   (tenant-tanımı + DB creds ikisi de yazılınca) bu uçlar durum-türevli
#   olarak OTOMATİK 404'e döner (H-1 fail-closed, in-memory bayrak DEĞİL).
#   Kurulum bittikten sonra bu değeri .env'den KALDIRIN/rotate edin.
SETUP_TOKEN=
