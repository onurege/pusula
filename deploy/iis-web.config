<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy — Enroute Pusula dashboard (Next :3000).
  IIS site kök klasörüne "web.config" olarak kopyala.

  ÖNKOŞUL (IIS'e bir kez):
    1. "Application Request Routing" (ARR) + "URL Rewrite" modüllerini kur
       (Web Platform Installer veya iis.net'ten).
    2. IIS Manager → sunucu düğümü → Application Request Routing Cache →
       (sağ) Server Proxy Settings → "Enable proxy" işaretle.
    3. IIS site → SSL sertifikası bağla (HTTPS 443) — cookie Secure ve
       HTTPS zorlaması bunun üzerine çalışır (GUV-07).
    4. (Opsiyonel) "WebSocket Protocol" Windows özelliğini aç.

  NOT: Yalnızca dashboard (3000) proxy'lenir. API (8080) 127.0.0.1'e bind
  (GUV-03) — dışarı hiç açılmaz, dashboard onu localhost'tan çağırır.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- HTTP → HTTPS zorla (HTTPS binding varsa) -->
        <rule name="ForceHttps" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Tüm istekleri Next dashboard'a proxy'le -->
        <rule name="ReverseProxyToNext" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
          <serverVariables>
            <!-- Rate-limit gerçek client IP'sini görsün (GUV-06) -->
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
            <!-- Uygulama HTTPS arkasında olduğunu bilsin -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <!-- serverVariables set edilebilmesi için allowlist gerekir:
         IIS Manager → URL Rewrite → View Server Variables → şu 3'ünü ekle:
         HTTP_X_FORWARDED_FOR, HTTP_X_FORWARDED_PROTO, HTTP_X_FORWARDED_HOST -->

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
