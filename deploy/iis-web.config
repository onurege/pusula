<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy — Enroute Pusula dashboard (Next :3000).
  IIS site kök klasörüne "web.config" olarak kopyala.

  MİMARİ (HTTP-only, SSL yok):
    Tarayıcı → IIS (9090) → Next dashboard (127.0.0.1:3000) → Hono API (127.0.0.1:8080)
    panorama.weitnauer.com.tr:9090 → bu site

  ÖNKOŞUL (IIS'e bir kez):
    1. "Application Request Routing" (ARR) + "URL Rewrite" modüllerini kur.
    2. IIS Manager → sunucu düğümü → Application Request Routing Cache →
       (sağ) Server Proxy Settings → "Enable proxy" işaretle.
    (X-Forwarded-* allowlist artık aşağıda <allowedServerVariables> ile gömülü;
     GUI'den eklemeye gerek yok.)

  NOT: ForceHttps kuralı ve HSTS header'ı KASITLI olarak yok. SSL sertifikası
  yokken HTTP isteğini HTTPS'e yönlendirmek "too many redirects" (sonsuz
  döngü) üretir. HTTPS eklendiğinde ForceHttps + HSTS geri açılabilir ve
  Secure cookie için COOKIE_INSECURE kaldırılır.

  NOT: Yalnızca dashboard (3000) proxy'lenir. API (8080) 127.0.0.1'e bind
  (GUV-03) — dışarı hiç açılmaz, dashboard onu localhost'tan çağırır.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <!-- serverVariables set edebilmek için allowlist ŞART; yoksa 500.50 -->
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_FOR" />
        <add name="HTTP_X_FORWARDED_PROTO" />
        <add name="HTTP_X_FORWARDED_HOST" />
      </allowedServerVariables>
      <rules>
        <!-- Tüm istekleri Next dashboard'a proxy'le -->
        <rule name="ReverseProxyToNext" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
          <serverVariables>
            <!-- Rate-limit gerçek client IP'sini görsün (GUV-06) -->
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
            <!-- HTTP-only kurulum: proto=http -->
            <set name="HTTP_X_FORWARDED_PROTO" value="http" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="20971520" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
