# =============================================================================
# Insider Kurulum - .env ornek dosyasi
# =============================================================================
# BU DOSYAYI ".env" olarak KOPYALAYIN ve asagidaki degerleri doldurun.
# ".env" dosyasi ASLA paylasilmaz/commit edilmez, gizli bilgi tasir.
#
# Sirasiyla doldurun (KURULUM.md Adim 2 ile birebir):
#   1) TENANT
#   2) JWT_SECRET, CONFIG_ENC_KEY, SETUP_TOKEN (uretim komutlari asagida)
#   3) Portlar (varsayilanlar genelde yeterli - netsh ile bos oldugunu dogrulayin)
#   4) DASHBOARD_ALLOWED_ORIGINS / COOKIE_INSECURE (yalniz gerekiyorsa)
# MSSQL kimlik bilgileri BURAYA YAZILMAZ - normal yolda tarayicidan /setup
# ekraniyla girilir (sifreli saklanir). MSSQL_* satirlari yalniz "IP-host /
# TLS" sorunu yasarsaniz kullanilacak YEDEK yoldur (KURULUM.md "Sorun Giderme"
# bolumune bakin).
# =============================================================================

# NODE_ENV: sabit "production" kalsin - degistirmeyin (auth/guard'lar bu
# degere gore SIKI moda gecer; dev/demo kisayollari kapanir).
NODE_ENV=production

# TENANT: bu sunucudaki musterinin kisa kimligi. Kural (kod tarafinda
# zorunlu kilinir - packages/core/src/tenant/tenant-id.ts):
#   yalnizca kucuk harf/rakam/tire, bas/son harf tire OLAMAZ, 1-40 karakter.
#   Regex: ^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$
#   Ornek: musteri-x, ornek-ticaret
# Bu deger BOS sunucuda "kodsuz kurulum" (setup modu) tetikleyicisidir - asla
# bilinen bir demo/dev tenant adiyla (pernod, pernod-demo, fmcg-demo,
# wietnauer) COPYLEMEYIN, aksi halde setup modu HIC ACILMAZ (o id'ler kod
# icinde onceden tanimli sayilir).
TENANT=

# JWT_SECRET: oturum (login) JWT imza anahtari. En az 16 karakter, rastgele.
# Uretim (PowerShell):
#   -join ((48..57)+(65..90)+(97..122)|Get-Random -Count 40|%{[char]$_})
# veya (OpenSSL varsa): openssl rand -base64 32
JWT_SECRET=

# CONFIG_ENC_KEY: Konfiguratorun (DB parolasi dahil) sifreli sakladigi
# alanlar icin AES-256-GCM anahtari. TAM 32 bayt = 64 haneli hex olmali.
# Eksik/hatali ise sifreli okuma/yazma FAIL-CLOSED (throw) olur - sessizce
# demo moda dusmez (bu DB kimlik bilgisi, sessiz dusme kabul edilemez).
# Uretim:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONFIG_ENC_KEY=

# SETUP_TOKEN: bos sunucuda ekrandan (/setup) kurulum yapabilmenin TEK
# kapisi. En az 32 BAYT rastgele deger - kisaysa setup modu FAIL-CLOSED
# devre disi kalir (guvenlik aciligi degil, sadece kurulum ekrani calismaz).
# Uretim (PowerShell):
#   -join ((48..57)+(65..90)+(97..122)|Get-Random -Count 40|%{[char]$_})
# ONEMLI: Kurulum TAMAMLANINCA (DB baglantisi + tenant kimligi kaydedildikten
# SONRA) bu satiri SILIN (veya degerini bosaltin) ve
#   powershell -ExecutionPolicy Bypass -File .\yeniden-baslat.ps1
# calistirin. Not: DB baglantisini asagidaki MSSQL_* yedek yoluyla (store
# yerine env ile) yaptiysaniz otomatik kapanma TETIKLENMEZ - bu adimi ELLE
# yapmaniz SARTTIR (KURULUM.md "Sorun Giderme" bolumune bakin).
SETUP_TOKEN=

# --- Portlar --------------------------------------------------------------
# Once bos oldugunu dogrulayin (Windows bazi port araliklarini Hyper-V/WSL
# icin rezerve edebilir - "EACCES"/"bind" hatasi verirse):
#   netsh interface ipv4 show excludedportrange protocol=tcp
# Cakisirsa asagidaki degerleri degistirip yeniden-baslat.ps1 calistirin.

# API_PORT / API_HOST: Hono API'nin ic (yalniz localhost) portu. Disariya
# ACILMAZ - dashboard ona 127.0.0.1 uzerinden baglanir.
API_PORT=4300
API_HOST=127.0.0.1

# PORT: Next.js dashboard'un disa acilan portu (tarayici bunu kullanir).
PORT=4200

# ENROUTE_API_URL: dashboard'un API'ye baglandigi adres - normalde
# API_PORT ile AYNI kalmali (http://127.0.0.1:<API_PORT>).
ENROUTE_API_URL=http://127.0.0.1:4300

# COOKIE_INSECURE: HTTP (TLS/SSL YOK) uzerinden erisiliyorsa "1" birakin -
# aksi halde login cookie'si "Secure" bayragi yuzunden taraycida TUTMAZ ve
# giris dongude kalir. Onune bir HTTPS reverse-proxy (IIS/nginx) koyarsaniz
# "0" yapin.
COOKIE_INSECURE=1

# DASHBOARD_ALLOWED_ORIGINS: YALNIZCA dashboard'u bir reverse-proxy (IIS/
# nginx) ARKASINDA sunuyorsaniz VE tarayicinin gordugu adres (ör.
# panorama.musteri.com) Next surecinin kendi Host'undan (127.0.0.1:PORT)
# FARKLIYSA doldurun (virgulle ayrik, ornek: panorama.musteri.com,
# panorama.musteri.com:9090). Dogrudan http://<sunucu-ip>:<PORT> ile
# erisiliyorsa (proxy YOK) BOS BIRAKIN - Next Origin=Host oldugu icin ekstra
# ayar gerekmez. Bkz. deploy/iis-web.config (ornek IIS reverse-proxy).
DASHBOARD_ALLOWED_ORIGINS=

# ADMIN_USERS: admin ekranlarina (Konfigurator, Yetkiler, Icerik) erisebilecek
# kullanici adlari (virgulle ayrik, TBLKULLANICI.TXTKULLANICIISIM ile birebir,
# buyuk/kucuk harf duyarli). BOS birakilirsa varsayilan "ERCYONETICI"dir - eger
# sizin admin kullaniciniz farkliysa (ör. rbadmin) giris yapsaniz bile admin
# ekranlari GORUNMEZ. Kendi merkez/admin kullanici adinizi yazin.
#   ornek: ADMIN_USERS=rbadmin
ADMIN_USERS=

# =============================================================================
# COK-DB (login'de veritabani secimi) - OPSIYONEL
# =============================================================================
# Ayni sunucu/kullanici uzerinde birden cok veritabani varsa (ör. Reckitt Core
# = RBHYHO, ESSHOME = ESSHOME) kullanicilar login ekraninda hangisine
# girecegini secebilir. ONERILEN yol: kurulumdan sonra tarayicidan
# Admin > Konfigurator > "F. Veritabanlari (cok-DB)" bolumunden {etiket, DB
# adi} satirlari ekleyin (kodsuz, sifreli saklanir). 2+ satir -> login'de
# dropdown; 0-1 -> tek-DB.
# Alternatif (env fallback): asagidaki degiskeni doldurun - ONEK = TENANT'in
# buyuk harfi (tire->alt cizgi). Bicim: virgulle ayrik "id:Etiket:DBADI".
#   ornek: MUSTERI_DATABASES=core:Reckitt Core:RBHYHO,ess:ESSHOME:ESSHOME
# (Store'dan yapilan kayit bu env'i EZER. Yalniz biri yeterli.)
# <ONEK-tenant>_DATABASES=

# SKIP_STARTUP_WARM: bos birakin (varsayilan). "1" verirseniz acilistaki
# ~10sn sonraki otomatik veri-tazeleme atlanir (yalniz DB henuz kurulmamisken
# loglardaki tek-seferlik "baglanti hatasi" gurultusunu azaltmak icin
# kullanilabilir - zararsizdir, atlamak da zararsizdir).
SKIP_STARTUP_WARM=

# =============================================================================
# YEDEK YOL - MSSQL_* (yalniz IP-host/TLS sorunu yasarsaniz kullanin)
# =============================================================================
# Normal yolda DB baglantisi tarayicidan /setup > "Adim 1 - DB Baglantisi"
# formuyla girilir (sifreli saklanir, port hep 1433, encrypt=true,
# trustServerCertificate=false varsayilir - bu ikisi formdan DEGISTIRILEMEZ).
# Eger MSSQL sunucunuz IP adresiyle erisiliyor VE kendinden-imzali/hostname'e
# ozel bir sertifika kullaniyorsa /setup formu "baglanti basarisiz" doner
# (KURULUM.md "Sorun Giderme" bolumune bakin) - bu durumda /setup DB adimini
# ATLAYIP asagidaki degiskenleri (TENANT'a gore turetilen ONEK ile) doldurun:
#   ONEK = TENANT'in BUYUK harfi, tire yerine alt-cizgi + "_MSSQL_"
#   ornek: TENANT=musteri-x  ->  ONEK = MUSTERI_X_MSSQL_
# <ONEK>SERVER=
# <ONEK>PORT=1433
# <ONEK>DATABASE=
# <ONEK>USER=
# <ONEK>PASSWORD=
# <ONEK>ENCRYPT=true
# <ONEK>TRUST_SERVER_CERT=true
