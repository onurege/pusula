{
  "name": "enroute-rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DBA agent backend + reporting dashboard over Univera MSSQL",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "schema:introspect": "tsx scripts/schema-introspect.ts",
    "schema:enrich": "tsx scripts/schema-enrich.ts",
    "test:retrieve": "tsx scripts/test-retrieve.ts",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p apps/mcp && tsc --noEmit -p apps/api && tsc --noEmit -p scripts",
    "mcp:start": "tsx apps/mcp/src/server.ts",
    "api:start": "tsx apps/api/src/server.ts",
    "dashboard:dev": "npm run dev -w @enroute/dashboard",

    "//tenant": "Tenant-aware shortcut'lar — TENANT env var hem API hem dashboard tarafından okunur. Pernod default; fmcg-demo karma FMCG demo verisi (Faz 2'de seed edilir).",
    "api:start:pernod":     "TENANT=pernod     tsx apps/api/src/server.ts",
    "api:start:fmcg":       "TENANT=fmcg-demo  tsx apps/api/src/server.ts",
    "api:start:wietnauer":  "TENANT=wietnauer  tsx apps/api/src/server.ts",
    "dashboard:dev:pernod":    "TENANT=pernod    npm run dev -w @enroute/dashboard",
    "dashboard:dev:fmcg":      "TENANT=fmcg-demo npm run dev -w @enroute/dashboard",
    "dashboard:dev:wietnauer": "TENANT=wietnauer npm run dev -w @enroute/dashboard"
  },
  "dependencies": {
    "@enroute/core": "*",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
